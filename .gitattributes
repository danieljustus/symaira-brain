# Source-bound oracles compare exact bytes on every runner.
* text=auto eol=lf

# libFuzzer corpus seeds deliberately contain protocol-level CRLF bytes.
# Treat them as binary so Git preserves those exact bytes and diff checks do not
# mistake the carriage returns for accidental trailing whitespace.
fuzz/corpus/** binary

# Preserve original native CI log bytes, including CRLF.
migration/evidence/usage-files-windows-runner/*.log binary

# Preserve the actual historical failed-suite log bytes.
migration/evidence/usage-copilot-kimi-768/original-unit-failure/original-tests.log -text
migration/evidence/usage-copilot-kimi-768/linux-f75993e/**/*.log -text
migration/evidence/usage-copilot-kimi-768/linux-f75993e/*.log -text
migration/evidence/usage-copilot-kimi-768/original-root-review-7e0b/** -text
