      "go": ["go", "test", "./internal/daemon", "-run", "SessionRegistry", "-count=1"],
      "rust": ["cargo", "test", "-p", "symbrowse-daemon", "--test", "session_registry", "--locked"]
    },
    {
      "id": "DMN-008-client-autostart",
      "platforms": ["darwin", "linux"],
      "go": ["go", "test", "./internal/daemon", "./cmd/symbrowse", "-run", "Autostart|Client|Engine", "-count=1"],
      "rust": ["cargo", "test", "-p", "symbrowse-daemon", "--test", "cancellation", "autostart", "--locked"]
    }
  ]
